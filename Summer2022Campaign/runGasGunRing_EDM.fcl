// This fhicl runs the gas gun for gm2ringsim with EDM

// Run on the grid:
// ./gridSetupAndSubmitGM2Data.sh --mc --truth --fhiclFile=/<path>/runGasGunRing_EDM.fcl --gasGun --localArea --output-dir=/pnfs/GM2/scratch/users/sgrant/30xBNL --njobs 5000 --nevents 50000 --lifetime=8h

#include "geom/collimator.fcl"
#include "mdc1.fcl"

source.firstRun    : 1
source.firstSubRun : 1

services.MagnetIronAndCryostat.produceArtRecords : false

//gm2FieldManager 
services.gm2FieldManager.fDeltaChord : 3.0
services.gm2FieldManager.DeltaOneStep : 0.01
services.gm2FieldManager.fDeltaIntersection : 0.001
services.gm2FieldManager.fStepMinEps : 5E-5
services.gm2FieldManager.fStepMaxEps : 0.001
services.gm2FieldManager.doSpinTracking : false

//set collimators to commissioning configuration
services.Geometry.collimator : @local::collimator_geom
services.Geometry.collimator.type : [0,1,0,0,0,0,0,1,0] //coll 4/5 and 10/11

services.message.destinations.LogToFile.filename : "gm2ringsim_particle_gun.log"
outputs.out1.fileName : "gm2ringsim_particle_gun.root"
outputs.out1.dataTier : "truth"

// Speed up MDC1 by only producing data for trackable tracks 
// I don't trust this killNonTrackerPositrons flag, the code has a lot of TODO statements and it seems to cut out station 0
// services.KillTracks.killNonTrackerPositrons : true // only allow events that yield a track in either station 
services.KillTracks.killPhotons : true 
services.KillTracks.killOpticalPhotons : true 
services.Calorimeter.killAllParticles : true 
services.Calorimeter.killOpticalPhotons : true 
services.Calorimeter.useSD : false

physics.filters.trackFilter.module_type : TrackFilter
physics.filters.trackFilter.filterOnStraws : true 
physics.filters.trackFilter.filterOnTracks : false  

// Keep track filter off to keep all decays
//physics.path1 :  [ randomsaver, artg4, trackFilter]  // selecting events from the TrackFilter filterOnStraws : true , filterOnTracks : false
physics.path1 :  [ randomsaver, artg4 ] // all decays 
outputs.out1.SelectEvents : [ path1 ]  // selecting events from the TrackFilter filterOnStraws : true , filterOnTracks : false


// reconstruction will get a new CS from service (not to pass truth misalignments to tracking)
outputs.out1.outputCommands : [ "keep *"
                        // "keep gm2truth::GasGunArtRecord_*_*_*",
                        //"keep gm2truth::StrawArtRecords_artg4_straws_mdc1",
                        //"keep gm2truth::GhostDetectorArtRecords_artg4_trackerdummyplane_mdc1"
                      ] 

//the default is to have only 1 tracker (S18), we want stations 0, 12, and 18
services.Geometry.strawtracker.whichScallopLocations : [0, 12, 18] 
services.Geometry.trackerdummyplane.whichScallopLocations : [0, 12, 18]

// // Add Run-1 beam distribution 
// services.GasGunBdyn.AxCBO : 13 // mm 
// services.GasGunBdyn.x0 : 6 // mm 

// Set all radial field variation to zero
services.gm2FieldManager.dBr_ppm : 0.0 // Default is zero
services.gm2FieldManager.magnitude : 0.0 //multiplicative factor magnitude of azimuthal radial variation

// Inject EDM 
// services.Gm2Constants.eMuon : 0 // no EDM 
// services.Gm2Constants.eMuon : 1.8e-19 // BNL EDM upper limit
// services.Gm2Constants.eMuon : 1.8e-18 // 10x BNL EDM upper limit 
services.Gm2Constants.eMuon : 5.4e-18 // 30x BNL EDM upper limit

// Add longitudinal field from Joe's update to MDC1 
// services.GasGunBdyn.setPseudoField : true
// services.GasGunBdyn.seqEvents : true
// services.GasGunBdyn.verbosity : 2
// services.GasGunBdyn.pseudoLongitudinalFieldPPM : 1700 //1700 ppm should give a 0.17 mRad tilt as measured by tracker (equiv of eMuon = 5.4E-18e.cm)
// services.GasGunBdyn.pseudoLongitudinalFieldPPM : 50 // 50 should give a 5um tilt as measured by tracker, 1.46 mRad tilt in MRF



