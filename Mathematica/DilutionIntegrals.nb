Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   FractionBox["1", 
    RowBox[{"16", " ", "\[Gamma]", " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"2", " ", 
         RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], ")"}], "2"]}]]}], 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"8", " ", "\[Lambda]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       RowBox[{"2", " ", 
        RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], ")"}]}], "+", 
    FractionBox[
     RowBox[{
      SqrtBox["6"], " ", 
      RowBox[{"ArcTanh", "[", 
