Notebook[{
Cell["\<\
<<ToMatlab.m
c = 1 + (gamma^2)*(Sin[theta]^2);
f1 = (2*gamma)/(15*Pi);
f2 = Sqrt[lambda*(1 - lambda*c)];
f3 = 22*c*lambda - 16*c^2*lambda^2 + 9;
F = f1*f2*f3;
FullSimplify[%];
Integrate[F, lambda, Assumptions -> {theta, lambda, gamma} \[Element] Reals \
&& lambda >= 0 && gamma > 0];
FullSimplify[%]\
\>", "Input",
 CellChangeTimes->{{3.870944083349078*^9, 3.870944323911714*^9}, {
   3.870944355179888*^9, 3.870944491374526*^9}, {3.870944548118678*^9, 
