Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{"gamma", " ", 
    RowBox[{"Cos", "[", "theta", "]"}], " ", 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{"15", " ", 
        RowBox[{"ArcSin", "[", 
         SqrtBox[
          RowBox[{"1", "+", 
           RowBox[{
            SuperscriptBox["gamma", "2"], " ", 
            SuperscriptBox[
             RowBox[{"Sin", "[", "theta", "]"}], "2"]}]}]], "]"}]}], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{
           SuperscriptBox["gamma", "2"], " ", 
           SuperscriptBox[
            RowBox[{"Sin", "[", "theta", "]"}], "2"]}]}], ")"}], 
        RowBox[{"3", "/", "2"}]]], "+", 
      FractionBox[
       RowBox[{
        SqrtBox[
         RowBox[{
          RowBox[{"-", 
           SuperscriptBox["gamma", "2"]}], " ", 
          SuperscriptBox[
           RowBox[{"Sin", "[", "theta", "]"}], "2"]}]], " ", 
        RowBox[{"(", 
         RowBox[{"15", "+", 
          RowBox[{"2", " ", 
           SuperscriptBox["gamma", "2"], " ", 
           SuperscriptBox[
            RowBox[{"Sin", "[", "theta", "]"}], "2"], " ", 
           RowBox[{"(", 
            RowBox[{"15", "-", 
             RowBox[{"8", " ", 
              SuperscriptBox["gamma", "2"], " ", 
              SuperscriptBox[
               RowBox[{"Sin", "[", "theta", "]"}], "2"], " ", 
              RowBox[{"(", 
               RowBox[{"1", "+", 
                RowBox[{
                 SuperscriptBox["gamma", "2"], " ", 
                 SuperscriptBox[
                  RowBox[{"Sin", "[", "theta", "]"}], "2"]}]}], ")"}]}]}], 
            ")"}]}]}], ")"}]}], 
       RowBox[{"1", "+", 
        RowBox[{
         SuperscriptBox["gamma", "2"], " ", 
         SuperscriptBox[
          RowBox[{"Sin", "[", "theta", "]"}], "2"]}]}]]}], ")"}]}], 
   RowBox[{"30", " ", "\[Pi]"}]], "//", "ToMatlab"}]], "Input",
