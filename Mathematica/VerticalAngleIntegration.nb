Cell["\<\
(gamma*Sqrt(-(lambda*(-1 + lambda + \
Power(gamma,2)*lambda*Power(Sin(theta),2))))*
     (2*lambda*(7 - 8*(-2 + lambda)*lambda) - 15/(1 + \
Power(gamma,2)*Power(Sin(theta),2)) + 
       (15*ArcSin(Sqrt(lambda)*Sqrt(1 + \
Power(gamma,2)*Power(Sin(theta),2))))/
        (Sqrt(lambda)*Power(1 + \
Power(gamma,2)*Power(Sin(theta),2),1.5)*Sqrt(1 - lambda - \
Power(gamma,2)*lambda*Power(Sin(theta),2))) - 
       16*Power(gamma,2)*Power(lambda,2)*Power(Sin(theta),2)*(-2 + 2*lambda + \
Power(gamma,2)*lambda*Power(Sin(theta),2))))/(30.*Pi)\
\>", "Output",
 CellChangeTimes->{3.871033715238216*^9},
 CellLabel->
  "Out[38]//CForm=",ExpressionUUID->"c450d4b3-cb1b-45c5-8e1f-9d66ff9f53d2"]
}, Open  ]],

