Cell[BoxData["\<\"(1/30).*gamma.*pi.^(-1).*cos(theta).*(15.*asin((1+gamma.^2.*\
sin( ...\\n  theta).^2).^(1/2)).*(1+gamma.^2.*sin(theta).^2).^(-3/2)+((-1).* \
...\\n  gamma.^2.*sin(theta).^2).^(1/2).*(1+gamma.^2.*sin(theta).^2).^(-1) \
...\\n  .*(15+2.*gamma.^2.*sin(theta).^2.*(15+(-8).*gamma.^2.*sin(theta) \
...\\n  .^2.*(1+gamma.^2.*sin(theta).^2))));\\n\"\>"], "Output",
