#include "messageParams.fcl"
#include "trackingConfig.fcl"

process_name : PhaseAnalyzer

source : 
{
  module_type : RootInput
  maxEvents   : -1
}

services : {

  message : {
    debugModules : []
    suppressInfo : []

    destinations : {
      LogToConsole : {
        type       : "cout"
        threshold  : "INFO"
        categories : @local::message_categories
      }
      LogToFile : {
        type      : "file"
        filename  : "phaseAnalyzerTree.log"
        append    :  false
        threshold : "INFO"
        categories : @local::message_categories
      }
    }
  } // end of message services
 
  // the coordinate system data is used throughout the tracking code
  // for now, the tracking uses GEANT for the coordinates
  // to build the coordinates requires dependent on artg4

  DetectorHolder    : {}
  ActionHolder      : {}
  CoordSystemsStore : {}
  Gm2Constants      : {}
  RandomNumberGenerator : {}

  TFileService: { fileName: "phaseAnalyzerTree.root"  }

} // end of services block
   
physics : {
  analyzers : {
    phaseAnalyzer : { module_type : G2PhaseAnalyzerVolumeInfo }
  } 			

  plot : [phaseAnalyzer]

  trigger_paths : []
  end_paths     : [plot]
} // end of physics block